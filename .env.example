# AWS credentials for Amazon Bedrock (Claude) — uses your free AWS credits
# Prefer: run `aws configure` after installing AWS CLI (do not commit real keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Prefer Bedrock when AWS creds exist (set to 0 to force direct Anthropic instead)
USE_BEDROCK=1

# Optional: override Bedrock Claude model ID if your region differs
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Alternative: direct Anthropic API (separate paid account — not needed if using Bedrock)
# ANTHROPIC_API_KEY=
